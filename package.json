{
  "name": "tiktok-clone",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node server/index.js",
    "client": "cd client && npm install && npm run dev -- --host 0.0.0.0",
    "dev-full": "concurrently \"npm run dev\" \"npm run client\"",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^8.0.1"
  }
}
