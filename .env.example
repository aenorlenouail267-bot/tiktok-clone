# Server
PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# MongoDB
MONGODB_URI=mongodb://localhost:27017/tiktok-clone-premium
# Ou pour MongoDB Atlas :
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tiktok-clone

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_12345
JWT_EXPIRE=7d
REFRESH_TOKEN_EXPIRE=30d

# File Upload
MAX_FILE_SIZE=104857600
ALLOWED_VIDEO_FORMATS=mp4,avi,mov,webm,mkv,flv
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp
UPLOAD_DIR=uploads

# Email (optionnel)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Client URLs
CLIENT_URL_WEB=http://localhost:5173
CLIENT_URL_MOBILE=exp://localhost:8081

# Streaming
STREAM_QUALITY_LOW=360p
STREAM_QUALITY_MID=720p
STREAM_QUALITY_HIGH=1080p
